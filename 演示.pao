# -*- 泡语言 -*-
# ============================================================
#  泡语言（PaoLang）演示程序
#  语法与 Python 完全一致，只是把关键词换成了中文
#  运行方式：泡语言.exe --run 演示.pao
# ============================================================

打印("吃了吗")
暂停（1）
打印("吃了，你呢？")

打印("--- 变量与运算 ---")

数量 = 3
价格 = 5.5
总价 = 数量 * 价格
打印("总价是：" + 字符串(总价))

打印("--- 定义函数与条件判断 ---")

定义 判断天气(温度):
    如果 温度 >= 30:
        返回 "太热了，注意防暑"
    否则如果 温度 >= 15:
        返回 "刚刚好，很舒服"
    否则:
        返回 "有点冷，多穿点"

打印(判断天气(35))
打印(判断天气(20))
打印(判断天气(5))

打印("--- 循环：对于 / 范围 / 列表 ---")

总数 = 0
对于 数字 在 范围(1, 6):
    总数 = 总数 + 数字
打印("1 加到 5 等于 " + 字符串(总数))

水果 = ["苹果", "香蕉", "橙子"]
对于 索引, 水果名 在 枚举(水果):
    打印(字符串(索引 + 1) + ". " + 水果名)

平方 = [数字 * 数字 对于 数字 在 范围(1, 6)]
打印("1~5 的平方：" + 字符串(平方))

打印("--- 字典 ---")

学生 = {"名字": "小明", "年龄": 12, "城市": "福州"}
打印("姓名：" + 学生["名字"] + "，年龄：" + 字符串(学生["年龄"]))

打印("--- 循环：当 ---")

计数 = 0
当 计数 < 3:
    打印("第 " + 字符串(计数 + 1) + " 次计数")
    计数 = 计数 + 1

打印("--- 异常处理 ---")

尝试:
    结果 = 10 / 0
除了 零除错误:
    打印("啊哦，不能除以零！")

打印("--- 类与对象 ---")

类 动物:
    定义 说话(自己, 声音):
        打印("动物说：" + 声音)

狗 = 动物()
狗.说话("汪汪")

打印("--- 全角标点也支持 ---")

如果 1 ＜ 2 且 3 ≥ 3：
    打印（"全角括号、冒号、小于号都能用"）

打印("--- 交互输入 ---")

尝试:
    名字 = 输入("你叫什么名字？（直接回车跳过）")
    如果 名字 != "":
        打印("你好，" + 名字 + "！欢迎使用泡语言。")
    否则:
        打印("没关系，下次告诉我你的名字吧。")
除了 文件结束错误:
    打印("（检测到非交互环境，跳过输入环节）")

打印("演示结束，再见！")
